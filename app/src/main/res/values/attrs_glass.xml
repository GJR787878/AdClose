<?xml version="1.0" encoding="utf-8"?>
<!--
  玻璃拟态按钮组件（GlassButtons，来自 com.gjr.glassbutton）自定义属性。
  统一控件风格：玻璃胶囊按钮，新按钮一律复用本组件，不另起样式（app-dev-specs §3.2）。
-->
<resources>
    <!-- 全局属性（Android 要求每个属性名全局唯一） -->
    <attr name="glassSelected" format="boolean" />
    <attr name="glassCornerRadius" format="dimension" />
    <attr name="glassHeight" format="dimension" />

    <!-- 玻璃胶囊按钮 -->
    <declare-styleable name="GlassCapsuleButton">
        <attr name="glassSelected" />
        <attr name="glassCornerRadius" />
    </declare-styleable>

    <!-- 玻璃导航栏（底部横排 / 左侧竖排） -->
    <declare-styleable name="GlassNavBar">
        <attr name="glassCornerRadius" />
        <attr name="glassHeight" />
    </declare-styleable>
</resources>
